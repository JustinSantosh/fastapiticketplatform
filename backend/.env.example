# Copy this file to .env and fill in real values. Never commit .env.

# SQLAlchemy URL, psycopg 3 driver: postgresql+psycopg://USER:PASSWORD@HOST:PORT/DBNAME
# URL-encode special characters in the PASSWORD (@ = %40, : = %3A, / = %2F, % = %25, # = %23).
# The database name is written exactly as created in pgAdmin (case-sensitive; SQLAlchemy
# does not decode it, so do NOT percent-encode it).
DATABASE_URL=postgresql+psycopg://postgres:change-me@localhost:5432/Yalla & co

# Used by pytest: the same database, but search_path points at a separate "test" schema,
# so tests create/drop their tables there and never touch the app's tables in "public"
TEST_DATABASE_URL=postgresql+psycopg://postgres:change-me@localhost:5432/Yalla & co?options=-csearch_path%3Dtest

# JWT signing secret. Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=120

# Comma-separated list of frontend origins allowed by CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
